PROJECT_ID=your-gcp-project-id
REGION=asia-northeast3
REPO_NAME=wod-strategist-repo-dev
API_SERVICE_NAME=wod-strategist-api-dev
WORKER_SERVICE_NAME=wod-strategist-worker-dev
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://sunjinlee@localhost:${POSTGRES_PORT}/wod_dev?sslmode=disable
TEST_DATABASE_URL=postgresql://sunjinlee@localhost:${POSTGRES_PORT}/wod_test?sslmode=disable
GCS_BUCKET_NAME=wod-strategist-uploads-dev
JWT_SIGNING_SECRET=your-jwt-signing-secret
# Completed-session deep analysis; short chunks/indexing remain Gemini 3.8 Flash.
GEMINI_MODEL=gemini-4-argon
GEMINI_THINKING_LEVEL=HIGH
GEMINI_THINKING_CHUNK=LOW
# Live recording features (apply migration 000051 before enabling; default off)
ENABLE_CAPTURE_FEEDBACK=false
ENABLE_CONTEXTUAL_COACHING=false
ENABLE_ACTIVITY_COUNTING=false

# Migrations 000052-000053 must be applied before deploying this API/worker build,
# whatever this flag is. The text-only analysis summary runs regardless of it;
# this flag only gates additional paid video highlight observations.
ENABLE_AGENTIC_HIGHLIGHTS=false

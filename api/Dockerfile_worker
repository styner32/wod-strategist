# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS builder
WORKDIR /app

RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY docs ./docs
COPY internal ./internal

RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.20
WORKDIR /app

RUN apk add --no-cache ca-certificates ffmpeg libass \
	&& adduser -D -g '' appuser

COPY --chown=appuser:appuser --from=builder /out/worker ./worker

USER appuser
ENTRYPOINT ["./worker"]

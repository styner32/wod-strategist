project_id           = "your-gcp-project-id"
region               = "asia-northeast3"
db_password          = "secure-db-password"
gemini_api_key       = "your-gemini-api-key"
environment          = "dev"
api_secret           = "your-api-secret"
jwt_secret           = "your-jwt-secret"
cloudflare_api_token = "your-cloudflare-api-token"
cloudflare_zone_id   = "your-cloudflare-zone-id"
pipeline_mode        = "legacy"

# Rollout of AI-consuming re-analysis feature flags
# Set to false to avoid exposing AI-consuming operations unless explicitly needed/quota has been approved.
enable_chunk_reanalysis   = false
enable_session_reanalysis = false

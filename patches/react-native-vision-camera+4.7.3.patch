+    self.sourceURL = sourceURL
+    self.clock = clock
+    self.onSegment = onSegment
+    self.onFinish = onFinish
+    self.onSourceFinalized = onSourceFinalized
+    self.transform = transform
+    size = CGSize(width: (videoSettings[AVVideoWidthKey] as? NSNumber)?.doubleValue ?? 0,
+                  height: (videoSettings[AVVideoHeightKey] as? NSNumber)?.doubleValue ?? 0)
+    guard frameDuration.isNumeric, frameDuration > .zero else {
+      throw Self.failure("Configured capture frame duration is unavailable")
+    }
+    nominalFrameDuration = frameDuration
+    analysisDirectory = sourceURL.deletingLastPathComponent().appendingPathComponent("analysis", isDirectory: true)
+    try FileManager.default.createDirectory(at: analysisDirectory, withIntermediateDirectories: true)
+    guard !FileManager.default.fileExists(atPath: sourceURL.path),
+          FileManager.default.createFile(atPath: sourceURL.path, contents: nil) else {
+      throw Self.failure("Original source already exists or cannot be created")
+    }
+    sourceFile = try FileHandle(forWritingTo: sourceURL)
+    writer = AVAssetWriter(contentType: .mpeg4Movie)
+    writer.outputFileTypeProfile = .mpeg4AppleHLS
+    writer.preferredOutputSegmentInterval = CMTime(seconds: interval, preferredTimescale: 60000)
+    writer.initialSegmentStartTime = mediaTimeOffset
+    writer.metadata = metadata
+    videoInput = AVAssetWriterInput(mediaType: .video, outputSettings: videoSettings)
+    videoInput.expectsMediaDataInRealTime = true
+    videoInput.transform = transform
+    guard writer.canAdd(videoInput) else { throw Self.failure("Video encoder settings unsupported") }
+    writer.add(videoInput)
+    if let audioFormat {
+      // Numeric-interval segmentation supports encoding A/V together, not an audio passthrough input.
+      guard let audioSettings else { throw Self.failure("Missing audio encoding settings") }

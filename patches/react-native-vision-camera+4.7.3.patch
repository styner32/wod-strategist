+  }
+
+  private func drainOutputs() {
+    // finishWriting has emitted its tail. This fence persists all delegate output before
+    // waiting for the independent preparation queue and reporting the terminal callback.
+    archiveQueue.async {
+      do { try self.sourceFile.synchronize(); try self.sourceFile.close() }
+      catch { self.setFatal(error) }
+      let (metadata, error) = self.result()
+      do { try self.writeManifest(terminal: metadata, error: error) }
+      catch { self.setFatal(error) }
+      let (confirmedMetadata, confirmedError) = self.result()
+      if confirmedError == nil { self.onSourceFinalized(confirmedMetadata) }
+      self.preparationQueue.async {
+        self.archiveQueue.async {
+          let (metadata, error) = self.result()
+          do { try self.writeManifest(terminal: metadata, error: error) }
+          catch { self.onFinish(metadata, error); return }
+          self.onFinish(metadata, error)
+        }
+      }
+    }
+  }
+
+  // Called on archiveQueue; only capture counters require the state lock.
+  private func result() -> ([String: Any], Error?) {
+    state.lock(); defer { state.unlock() }
+    let start = firstVideoTime ?? .zero
+    let error = fatalError ?? writer.error ??
+      (writer.status == .completed && firstVideoTime != nil ? nil : Self.failure("Original recording is incomplete"))
+    return (["segmented": true, "path": sourceURL.absoluteString,
+      "duration": max(0, (lastVideoEnd - start).seconds), "width": size.width, "height": size.height,
+      "captureStartTimeMs": epochAnchorMs + start.seconds * 1000,
+      "captureEndTimeMs": epochAnchorMs + lastVideoEnd.seconds * 1000,
+      "captureClockOffsetMs": epochAnchorMs - clockAnchor.seconds * 1000,
+      "segments": preparedEvents.map { event in
+        var terminalEvent = event
+        terminalEvent["isLast"] = (event["index"] as? Int) == entries.count
+        return terminalEvent
+      }, "segmentCount": entries.count, "failedSegmentCount": failedSegmentCount,
+      "droppedVideoFrames": droppedVideoFrames, "droppedAudioBuffers": droppedAudioBuffers,
+      "tailDrainTimedOut": tailDrainTimedOut], error)
+  }
+
+  func assetWriter(_ writer: AVAssetWriter, didOutputSegmentData data: Data,
+                   segmentType: AVAssetSegmentType, segmentReport: AVAssetSegmentReport?) {
+    let segmentLength = data.count
+    let videoReport = segmentReport?.trackReports.first(where: { $0.mediaType == .video })
+    let start = videoReport?.earliestPresentationTimeStamp
+    let duration = videoReport?.duration
+    state.lock()
+    pendingArchiveBytes += data.count
+    let overwhelmed = pendingArchiveBytes > 128 * 1024 * 1024
+    state.unlock()
+    // Delegate output is immutable compressed data; no raw frame or export work is held here.
+    archiveQueue.async {
+      defer {
+        self.state.lock(); self.pendingArchiveBytes -= data.count; self.state.unlock()
+      }
+      do {
+        let offset = self.committedLength
+        try self.sourceFile.write(contentsOf: data)
+        try self.sourceFile.synchronize()
+        self.committedLength += UInt64(data.count)
+        if segmentType == .initialization {
+          self.initializationLength = UInt64(data.count)
+          try self.writeManifest()
+          return
+        }
+        guard segmentType == .separable else { throw Self.failure("Unknown fragment type") }
+        let index = self.entries.count + 1
+        guard let start, let duration, start.isNumeric, duration.isNumeric, duration > .zero else {
+          throw Self.failure("Fragment lacks native video timing")
+        }
+        let entry: [String: Any] = ["index": index, "offset": offset, "length": data.count,
+                                  "startSeconds": start.seconds, "durationSeconds": duration.seconds]
+        self.entries.append(entry)
+        try self.writeManifest()
+        let initializationLength = self.initializationLength
+        self.preparationQueue.async {
+          var event: [String: Any] = ["sourcePath": self.sourceURL.absoluteString, "index": index,
+            "duration": duration.seconds,
+            "captureStartTimeMs": self.epochAnchorMs + (start - self.mediaTimeOffset).seconds * 1000,
+            "captureEndTimeMs": self.epochAnchorMs + (start + duration - self.mediaTimeOffset).seconds * 1000,
+            "captureClockOffsetMs": self.epochAnchorMs - self.clockAnchor.seconds * 1000]
+          do {
+            let output = try self.prepareAnalysis(index: index, offset: offset, length: segmentLength,
+                                                  initializationLength: initializationLength,
+                                                  start: start, duration: duration)
+            event["status"] = "ready"
+            event["path"] = output.absoluteString
+          } catch {
+            event["status"] = "failed"
+            event["error"] = error.localizedDescription
+            self.archiveQueue.sync { self.failedSegmentCount += 1 }
+          }
+          self.archiveQueue.sync { self.preparedEvents.append(event) }
+          self.onSegment(event)
+        }
+      } catch {
+        // Preserve every already-committed byte. Fatal archive errors terminate input;
+        // analysis-only failures above never stop the source encoder.
+        self.setFatal(error)
+        DispatchQueue.global(qos: .userInitiated).async {
+          self.state.lock(); defer { self.state.unlock() }; self.finishLocked()
+        }
+      }
+    }
+    if overwhelmed {
+      setFatal(Self.failure("Original storage cannot keep up with capture; saved source retained"))
+      DispatchQueue.global(qos: .userInitiated).async {
+        self.state.lock(); defer { self.state.unlock() }; self.finishLocked()
+      }
+    }
+  }
+
+  private func prepareAnalysis(index: Int, offset: UInt64, length: Int, initializationLength: UInt64,
+                               start: CMTime, duration: CMTime) throws -> URL {
+    guard initializationLength > 0 else { throw Self.failure("Missing initialization fragment") }
+    let stem = sourceURL.deletingPathExtension().lastPathComponent + "-segment-\(index)"
+    let fragment = analysisDirectory.appendingPathComponent(stem + "-fragment.mp4")
+    let output = analysisDirectory.appendingPathComponent(stem + ".mp4")
+    guard !FileManager.default.fileExists(atPath: output.path) else { throw Self.failure("Analysis destination exists") }
+    FileManager.default.createFile(atPath: fragment.path, contents: nil)
+    let destination = try FileHandle(forWritingTo: fragment)
+    let original = try FileHandle(forReadingFrom: sourceURL)
+    do {
+      try Self.copy(from: original, to: destination, offset: 0, length: initializationLength)
+      try Self.copy(from: original, to: destination, offset: offset, length: UInt64(length))
+      try destination.close(); try original.close()
+    } catch { try? destination.close(); try? original.close(); throw error }
+    defer { try? FileManager.default.removeItem(at: fragment) }
+    let asset = AVURLAsset(url: fragment, options: [AVURLAssetPreferPreciseDurationAndTimingKey: true])
+    guard let video = asset.tracks(withMediaType: .video).first else { throw Self.failure("Fragment has no video") }
+    let composition = AVMutableComposition()
+    guard let target = composition.addMutableTrack(withMediaType: .video, preferredTrackID: kCMPersistentTrackID_Invalid) else {
+      throw Self.failure("Cannot create analysis video track")
+    }
+    // AVURLAsset normalizes an isolated HLS fragment to its local movie timeline.
+    // The segment report remains in encoder time and is used only for capture metadata.
+    let sourceRange = video.timeRange
+    try target.insertTimeRange(sourceRange, of: video, at: .zero)
+    target.preferredTransform = video.preferredTransform
+    let sourceAudio = asset.tracks(withMediaType: .audio).first
+    if let sourceAudio {
+      let audioRange = CMTimeRangeGetIntersection(sourceRange, otherRange: sourceAudio.timeRange)
+      if audioRange.duration > .zero {
+        guard let audio = composition.addMutableTrack(withMediaType: .audio, preferredTrackID: kCMPersistentTrackID_Invalid) else {
+          throw Self.failure("Cannot create analysis audio track")
+        }
+        try audio.insertTimeRange(audioRange, of: sourceAudio, at: audioRange.start - sourceRange.start)
+      }
+    }
+    guard let exporter = AVAssetExportSession(asset: composition, presetName: AVAssetExportPresetPassthrough),
+          exporter.supportedFileTypes.contains(.mp4) else { throw Self.failure("MP4 passthrough is unsupported") }
+    exporter.outputURL = output
+    exporter.outputFileType = .mp4
+    let done = DispatchSemaphore(value: 0)
+    exporter.exportAsynchronously { done.signal() }
+    if done.wait(timeout: .now() + 30) == .timedOut {
+      exporter.cancelExport()
+      _ = done.wait(timeout: .now() + 5)
+      throw Self.failure("Analysis packaging timed out; original source retained")
+    }
+    guard exporter.status == .completed else {
+      try? FileManager.default.removeItem(at: output)
+      throw exporter.error ?? Self.failure("Analysis packaging failed")
+    }
+    do {
+      let result = AVURLAsset(url: output, options: [AVURLAssetPreferPreciseDurationAndTimingKey: true])
+      guard let resultVideo = result.tracks(withMediaType: .video).first,
+            result.duration.isNumeric, result.duration > .zero else { throw Self.failure("Analysis video is empty") }
+      let before = try Self.sampleCount(asset: asset, track: video, range: sourceRange)
+      let after = try Self.sampleCount(asset: result, track: resultVideo, range: nil)
+      guard before > 0, before == after else { throw Self.failure("Analysis packaging changed video sample count") }
+      if sourceAudio != nil && result.tracks(withMediaType: .audio).isEmpty {
+        throw Self.failure("Analysis packaging lost audio")
+      }
+      return output
+    } catch { try? FileManager.default.removeItem(at: output); throw error }
+  }
+
+  private func writeManifest(terminal: [String: Any]? = nil, error: Error? = nil) throws {
+    var manifest: [String: Any] = ["version": 1, "sourcePath": sourceURL.lastPathComponent,
+      "committedBytes": committedLength, "initializationBytes": initializationLength,
+      "mediaTimeOffsetSeconds": mediaTimeOffset.seconds,
+      "clock": "native_capture_clock_anchored_epoch_ms", "epochAnchorMs": epochAnchorMs,
+      "segments": entries, "complete": terminal != nil && error == nil &&
+        (terminal?["droppedVideoFrames"] as? Int ?? 0) == 0 &&
+        (terminal?["droppedAudioBuffers"] as? Int ?? 0) == 0 &&
+        (terminal?["tailDrainTimedOut"] as? Bool ?? false) == false]
+    if let terminal { manifest["result"] = terminal }
+    if let error { manifest["error"] = error.localizedDescription }
+    let data = try JSONSerialization.data(withJSONObject: manifest, options: [.sortedKeys])
+    try data.write(to: sourceURL.appendingPathExtension("segments.json"), options: .atomic)
+  }
+
+  private func setFatal(_ error: Error) {
+    state.lock(); if fatalError == nil { fatalError = error }; state.unlock()
+  }
+
+  private static func rebase(_ buffer: CMSampleBuffer, by offset: CMTime) throws -> CMSampleBuffer {
+    var count = 0
+    var status = CMSampleBufferGetSampleTimingInfoArray(buffer, entryCount: 0, arrayToFill: nil, entriesNeededOut: &count)
+    guard status == noErr else { throw failure("Cannot read sample timing") }
+    var timing = Array(repeating: CMSampleTimingInfo(), count: count)
+    status = CMSampleBufferGetSampleTimingInfoArray(buffer, entryCount: count, arrayToFill: &timing, entriesNeededOut: &count)
+    guard status == noErr else { throw failure("Cannot copy sample timing") }
+    for index in timing.indices {
+      timing[index].presentationTimeStamp = timing[index].presentationTimeStamp - offset
+      if timing[index].decodeTimeStamp.isNumeric { timing[index].decodeTimeStamp = timing[index].decodeTimeStamp - offset }
+    }
+    var copy: CMSampleBuffer?
+    status = CMSampleBufferCreateCopyWithNewTiming(allocator: kCFAllocatorDefault, sampleBuffer: buffer,
+      sampleTimingEntryCount: count, sampleTimingArray: &timing, sampleBufferOut: &copy)
+    guard status == noErr, let copy else { throw failure("Cannot rebase sample timing") }
+    return copy
+  }
+
+  private static func copy(from source: FileHandle, to destination: FileHandle, offset: UInt64, length: UInt64) throws {
+    try source.seek(toOffset: offset)
+    var remaining = length
+    while remaining > 0 {
+      let data = try source.read(upToCount: Int(min(remaining, 1024 * 1024))) ?? Data()
+      guard !data.isEmpty else { throw failure("Incomplete persisted fragment") }
+      try destination.write(contentsOf: data)
+      remaining -= UInt64(data.count)
+    }
+  }
+
+  private static func sampleCount(asset: AVAsset, track: AVAssetTrack, range: CMTimeRange?) throws -> Int {
+    let reader = try AVAssetReader(asset: asset)
+    if let range { reader.timeRange = range }
+    let output = AVAssetReaderTrackOutput(track: track, outputSettings: nil)
+    output.alwaysCopiesSampleData = false
+    reader.add(output)
+    guard reader.startReading() else { throw reader.error ?? failure("Cannot read compressed samples") }
+    var count = 0
+    while let buffer = output.copyNextSampleBuffer() { count += CMSampleBufferGetNumSamples(buffer) }
+    guard reader.status == .completed else { throw reader.error ?? failure("Compressed sample read failed") }
+    return count
+  }
+
+  private static func failure(_ message: String) -> NSError {
+    NSError(domain: "WODSegmentedRecording", code: 1, userInfo: [NSLocalizedDescriptionKey: message])
+  }
+}

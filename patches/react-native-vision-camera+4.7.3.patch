+// WOD experimental recording: one encoder, durable source, independent analysis derivatives.
+// Kept separate from RecordingSession so the default VisionCamera path is unchanged.
+import AVFoundation
+import Foundation
+import UniformTypeIdentifiers
+
+protocol SegmentedRecording: AnyObject {
+  func append(buffer: CMSampleBuffer, isVideo: Bool)
+  func stop()
+  func recordCaptureDrop(buffer: CMSampleBuffer)
+}
+
+// Encoder settings come from delivered microphone PCM, not the device's nominal format.
+struct SegmentedAudioConfiguration {
+  let format: CMFormatDescription
+  let settings: [String: Any]
+
+  init(format: CMFormatDescription, recommended: [String: Any]?) throws {
+    guard CMFormatDescriptionGetMediaType(format) == kCMMediaType_Audio,
+          let description = CMAudioFormatDescriptionGetStreamBasicDescription(format)?.pointee,
+          description.mSampleRate.isFinite, description.mSampleRate > 0,
+          description.mChannelsPerFrame > 0 else {
+      throw NSError(domain: "SegmentedAudioStartup", code: 1,
+                    userInfo: [NSLocalizedDescriptionKey: "Microphone delivered an invalid audio format"])
+    }
+    self.format = format
+    if let recommended, !recommended.isEmpty {
+      settings = recommended
+    } else {
+      // Some capture outputs do not supply MP4 recommendations. This is the
+      // initial camera encode; retain the actual input rate and channel count.
+      settings = [AVFormatIDKey: kAudioFormatMPEG4AAC,
+                  AVSampleRateKey: description.mSampleRate,
+                  AVNumberOfChannelsKey: description.mChannelsPerFrame,
+                  AVEncoderBitRateKey: min(320000, 128000 * Int(description.mChannelsPerFrame))]
+    }
+  }
+}
+
+// Exactly one startup outcome, serialized with camera start/stop. The audio
+// delegate only offers real buffers; it never blocks waiting for camera work.
+final class SegmentedAudioStartup {
+  private let queue: DispatchQueue
+  private var completion: ((SegmentedAudioStartup, Result<SegmentedAudioConfiguration, Error>) -> Void)?
+
+  init(queue: DispatchQueue, timeout: Double = 5,
+       completion: @escaping (SegmentedAudioStartup, Result<SegmentedAudioConfiguration, Error>) -> Void) {
+    self.queue = queue
+    self.completion = completion
+    queue.asyncAfter(deadline: .now() + timeout) { [weak self] in
+      self?.finish(.failure(NSError(domain: "SegmentedAudioStartup", code: 2,
+        userInfo: [NSLocalizedDescriptionKey: "Microphone produced no usable audio buffer before startup timeout"])))
+    }
+  }
+
+  func receive(_ buffer: CMSampleBuffer, recommended: [String: Any]?) {
+    guard CMSampleBufferDataIsReady(buffer), CMSampleBufferGetNumSamples(buffer) > 0,
+          let format = CMSampleBufferGetFormatDescription(buffer) else { return }
+    let result = Result { try SegmentedAudioConfiguration(format: format, recommended: recommended) }
+    queue.async { self.finish(result) }
+  }
+
+  func fail(_ error: Error) {
+    queue.async { self.finish(.failure(error)) }
+  }
+
+  // Call on the camera queue so a stop already being handled wins over queued audio.
+  func cancel(_ error: Error) { finish(.failure(error)) }
+
+  private func finish(_ result: Result<SegmentedAudioConfiguration, Error>) {
+    let callback = completion
+    completion = nil
+    callback?(self, result)
+  }
+}
+
+// Release the active capture/audio identity when its source is closed, while keeping
+// its later analysis-drained callback alive. All coordinator state belongs to queue.
+final class SegmentedRecordingCompletion {
+  private let queue: DispatchQueue
+  private let releaseActive: (@escaping () -> Void) -> Void
+  private let onSource: ([String: Any]) -> Void
+  private let onFinish: ([String: Any], Error?) -> Void
+  private var source: [String: Any]?
+  private var terminal: ([String: Any], Error?)?
+  private var releaseStarted = false
+  private var released = false
+  private var sourceDelivered = false
+  private var finishDelivered = false
+
+  init(queue: DispatchQueue, releaseActive: @escaping (@escaping () -> Void) -> Void,
+       onSource: @escaping ([String: Any]) -> Void,
+       onFinish: @escaping ([String: Any], Error?) -> Void) {
+    self.queue = queue; self.releaseActive = releaseActive
+    self.onSource = onSource; self.onFinish = onFinish
+  }
+
+  func sourceFinalized(_ value: [String: Any]) {
+    queue.async { self.source = value; self.releaseOnce(); self.deliver() }
+  }
+
+  func drained(_ value: [String: Any], error: Error?) {
+    queue.async { self.terminal = (value, error); self.releaseOnce(); self.deliver() }
+  }
+
+  private func releaseOnce() {
+    guard !releaseStarted else { return }
+    releaseStarted = true
+    releaseActive {
+      self.queue.async { self.released = true; self.deliver() }
+    }
+  }
+
+  private func deliver() {
+    guard released else { return }
+    if let source, !sourceDelivered { sourceDelivered = true; onSource(source) }
+    if let terminal, !finishDelivered { finishDelivered = true; onFinish(terminal.0, terminal.1) }
+  }
+}

+
+  func recordCaptureDrop(buffer: CMSampleBuffer) {
+    state.lock(); defer { state.unlock() }
+    let pts = CMSampleBufferGetPresentationTimeStamp(buffer)
+    guard started, !finishing, pts.isNumeric, pts >= clockAnchor,
+          stopTime == nil || pts <= stopTime! else { return }

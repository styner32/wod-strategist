+
+  private func recordDrop(_ isVideo: Bool) {
+    if isVideo { droppedVideoFrames += 1 } else { droppedAudioBuffers += 1 }
+  }
+
+  // Called with state held, after append has returned. No subsequent input is admitted.
+  private func finishLocked() {
+    guard !finishing else { return }
+    finishing = true
+    if writer.status == .writing {
+      videoInput.markAsFinished()
+      audioInput?.markAsFinished()
+      // Do not end at last PTS: that would trim the final sample's presentation duration.
+      writer.finishWriting { self.drainOutputs() }
+    } else {
+      drainOutputs()

{
  "name": "wod-strategist",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios --scheme wodstrategist",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "NODE_PATH=__mocks__ jest",
    "typecheck": "tsc --noEmit",
    "generate-types": "swagger2openapi ./api/docs/swagger.json -o ./api/docs/openapi.json && openapi-typescript ./api/docs/openapi.json -o ./features/wod/schema.d.ts",
    "sync-api": "cd api && swag init -g cmd/server/main.go && cd .. && npm run generate-types"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "expo": "~57.0.23",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.19",
    "expo-constants": "~57.0.18",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.21",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-video-thumbnails": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-compressor": "^1.16.0",
    "react-native-fast-tflite": "^2.0.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-modules": "^0.31.10",
    "react-native-nitro-screen-recorder": "^0.6.1",
    "react-native-quick-base64": "^2.2.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "1.6.3",
    "tailwind-merge": "^3.4.0",
    "ulid": "^3.0.2",
    "vision-camera-resize-plugin": "^3.2.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "msw": "^2.12.14",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "swagger2openapi": "^7.0.8",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "react-native-reanimated": {
      "react-native-worklets": "$react-native-worklets"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

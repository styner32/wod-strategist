{
  "name": "wod-strategist",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "NODE_PATH=__mocks__ jest",
    "typecheck": "tsc --noEmit",
    "generate-types": "swagger2openapi ./api/docs/swagger.json -o ./api/docs/openapi.json && openapi-typescript ./api/docs/openapi.json -o ./features/wod/schema.d.ts",
    "sync-api": "cd api && swag init -g cmd/server/main.go && cd .. && npm run generate-types"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "^2.5.3",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "expo": "55",
    "expo-build-properties": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.6",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "~55.0.8",
    "expo-media-library": "~55.0.10",
    "expo-router": "~55.0.7",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "expo-video-thumbnails": "~55.0.11",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-ble-plx": "^3.5.0",
    "react-native-compressor": "^1.16.0",
    "react-native-fast-tflite": "^2.0.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-nitro-modules": "^0.31.10",
    "react-native-nitro-screen-recorder": "^0.6.1",
    "react-native-quick-base64": "^2.2.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.7.4",
    "react-native-worklets-core": "1.6.3",
    "tailwind-merge": "^3.4.0",
    "vision-camera-resize-plugin": "^3.2.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "msw": "^2.12.14",
    "openapi-typescript": "^7.13.0",
    "react-test-renderer": "^19.1.0",
    "swagger2openapi": "^7.0.8",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "react-native-reanimated": {
      "react-native-worklets": "$react-native-worklets"
    }
  }
